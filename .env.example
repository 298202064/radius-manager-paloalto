# Database
DB_NAME=radius
DB_USER=radius
DB_PASSWORD=radiuspass

# JWT (必填: 生成强随机密钥，至少32字符)
# 生成: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Encryption (Fernet key, generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=

# Token lifetimes
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=http://localhost:8081

# RADIUS 内部端点 IP 白名单（逗号分隔，支持 CIDR）
# FreeRADIUS 通过 Docker 内部网络调用时无需修改
RADIUS_ALLOWED_IPS=127.0.0.1,::1,172.16.0.0/12,10.0.0.0/8,192.168.0.0/16

# Redis
REDIS_URL=redis://redis:6379/0

# Database URL for backend
DATABASE_URL=postgresql+asyncpg://radius:radiuspass@postgres:5432/radius
