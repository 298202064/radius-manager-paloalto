# Database
DB_NAME=radius
DB_USER=radius
DB_PASSWORD=radiuspass

# JWT
SECRET_KEY=your-super-secret-jwt-key-change-in-production

# Encryption (Fernet key, generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=

# Token lifetimes
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=http://localhost:8081

# Redis
REDIS_URL=redis://redis:6379/0

# Database URL for backend
DATABASE_URL=postgresql+asyncpg://radius:radiuspass@postgres:5432/radius
